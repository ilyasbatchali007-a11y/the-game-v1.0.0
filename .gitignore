```gitignore
# TypeScript/JavaScript build artifacts
*.js.map
*.tsbuildinfo
dist/
build/
lib/

# Dependencies
node_modules/

# Logs and temporary files
*.log
*.tmp

# Environment variables
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/

# Coverage reports
coverage/
htmlcov/

# OS generated files
.DS_Store
Thumbs.db
```
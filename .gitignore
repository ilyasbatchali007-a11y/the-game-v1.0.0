```gitignore
# Dependencies
node_modules/
.pnpm-store/
.npm/
.yarn/

# Build outputs
dist/
build/
coverage/
.nyc_output/
.eslintcache

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.*
!.env.example

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
Thumbs.db

# Python specific
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.git/
.mypy_cache/
.pytest_cache/
.hypothesis/

# Node.js specific
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# TypeScript/JavaScript specific
*.tsbuildinfo
.next/
nuxt.config.js
.nuxt/
output.css

# Go specific
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.prof
vendor/

# Java specific
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*.log
replay_pid*.log
*.pid
.java-version
!*.java
!*.properties
!*.xml
!*.yml
!*.yaml
!*.json
!*.md
!*.txt
!*.sh
!*.bat
!*.cmd
!*.ps1
!*.pl
